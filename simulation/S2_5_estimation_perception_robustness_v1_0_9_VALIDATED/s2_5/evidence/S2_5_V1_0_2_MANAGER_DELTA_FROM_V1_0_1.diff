+function meta=augment_s23_recovery_meta_local(baseMeta,reason)
+% Normalize frozen S2.3 planner metadata to the S2.4/S2.5 mission schema.
+meta=baseMeta;
+meta.reason=reason;
+meta.explorationUsed=false;
+meta.selectedFrontierTrackId=uint64(0);
+meta.selectedCandidateId=uint64(0);
+meta.frontierDiagnostics=struct();
+meta.viewpointDiagnostics=struct();
+meta.decisionEvidence=struct();
+end
